<!-- Final CTA Section -->
<section class="section section-cta">
  <div class="cta-box">
    <h2 data-content-id="packages-final-cta-title">Klaar om te boeken?</h2>
    <p data-content-id="packages-final-cta-text">
      Vertel ons over je groep en gewenste datum. We sturen je binnen 24 uur een vrijblijvende
      offerte. Vragen? Bel ons direct op <strong>06 12 34 56 78</strong>.
    </p>
    <div class="cta-actions">
      <a href="/offerte/" class="btn btn-lg" data-content-id="packages-final-cta-button">Vraag offerte aan</a>
      <a href="/contact/" class="link" data-content-id="packages-final-cta-contact">Of neem contact op</a>
    </div>
  </div>
</section>

<!-- FAQ: Critical Questions -->
<section id="faq" class="section">
  <h2 data-content-id="packages-faq-title">Veelgestelde Vragen</h2>
  {% set page = "packages" %}
  {% include "components/faq-list.njk" %}
</section>
