---
layout: layouts/base.njk
title: De Zeilkeuken - Arrangementen en prijzen
---

<!-- Intro Section -->
<section id="arrangementen-overzicht" class="section section-white">
  <div class="section-container">
    <h2 data-content-id="packages-title" style="text-align: center;">Samen genieten op het water</h2>
    <div class="intro-content">
      <div class="intro-grid">
      <div>
        <p data-content-id="packages-hero-intro">
          Op onze traditionele tjalk maak je met je groep een onvergetelijke dag mee. Of het nu gaat om een
          teamuitje, familiefeest of vriendendag: bij ons draait alles om gezelligheid, lekker eten en
          samen zijn op het IJsselmeer.
        </p>
        <p data-content-id="packages-hero-practical">
          Van april tot oktober varen we met groepen van 25 tot 40 personen vanuit Muiden. Alles is
          inbegrepen: varen, eten, drinken.
        </p>
      </div>
      <div>
        <ul class="list-check">
          <li data-content-id="value-prop-kitchen-title">Live keuken aan boord</li>
          <li data-content-id="value-prop-ship-title">Traditionele tjalk uit 1892</li>
          <li data-content-id="value-prop-inclusive-title">Alles inclusief</li>
          <li data-content-id="value-prop-intimate-title">Kleinschalig, max 40 gasten</li>
        </ul>
      </div>
      </div>
    </div>

    <!-- Package Comparison Table -->
    <div class="package-comparison-wrapper">
      <table class="package-comparison-table">
        <thead>
          <tr>
            <th>Arrangement</th>
            <th class="th-duration">Duur</th>
            <th>Beste voor</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for pkg in packages | values %}
          <tr class="package-row" onclick="window.location.href='#{{ pkg.slug }}'">
            <td class="package-name">
              <a href="#{{ pkg.slug }}">{{ pkg.content.name }}</a>
            </td>
            <td class="package-duration">
              {% if pkg.defaults.departure and pkg.defaults.endTime %}
                {{ pkg.defaults.departure | durationHours(pkg.defaults.endTime) }} uur
              {% else %}
                Op maat
              {% endif %}
            </td>
            <td class="package-bestfor">{{ pkg.content.bestFor }}</td>
            <td class="package-arrow">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

    </div>
</section>

<!-- Detailed Package Sections -->
{% for pkg in packages | values %}
<section id="{{ pkg.slug }}" class="section package-detail">
  <div class="package-hero">
    <img
      src="{% if pkg.slug == 'dinervaart' %}/images/pampus-sunset.webp{% elif pkg.slug == 'langevaart' %}/images/marken.jpg{% else %}/images/vuurtoreneiland.jpg{% endif %}"
      alt="{{ pkg.content.name }} arrangement"
      class="package-hero-image"
    />
    <div class="package-hero-overlay">
      <div class="package-hero-header">
        <h2>{{ pkg.content.name }}</h2>
      </div>
      <div class="badge-group">
        {% for badge in pkg.content.badges %}
        <span class="badge">{{ badge }}</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="package-content">
    <!-- Description -->
    <div class="package-description">
      {{ pkg.content.longDescription | markdown | safe }}
    </div>

    <!-- Timeline (collapsed by default) -->
    {% if pkg.content.timeline %}
    <details class="timeline-details">
      <summary>Jouw dag (Indicatief)</summary>
      <div class="timeline">
        {% for item in pkg.content.timeline %}
        <div class="timeline-item">
          <span class="timeline-time">{{ item.time }}</span>
          <div class="timeline-content">
            <strong>{{ item.title }}</strong>
            <p>{{ item.description }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </details>
    {% endif %}

    <!-- Inclusions -->
    <div class="package-inclusions">
      <ul class="list-check">
        {% for highlight in pkg.content.highlights %}
        <li>{{ highlight }}</li>
        {% endfor %}
      </ul>
    </div>

    <!-- Practical Info -->
    <div class="package-practical">
      <h3>Praktische informatie</h3>
      <div class="practical-grid grid-2">
        <div class="practical-item">
          <strong>Duur:</strong> {% if pkg.defaults.departure and pkg.defaults.endTime %}{{ pkg.defaults.departure | durationHours(pkg.defaults.endTime) }} uur{% else %}Op maat{% endif %}
        </div>
        <div class="practical-item">
          <strong>Vertrek:</strong> {{ pkg.defaults.departure }}
        </div>
        <div class="practical-item">
          <strong>Groepsgrootte:</strong> {% if pkg.constraints.minGuests %}{{ pkg.constraints.minGuests }}-{{ pkg.constraints.maxGuests }}{% else %}tot {{ pkg.constraints.maxGuests }}{% endif %} personen
        </div>
        <div class="practical-item">
          <strong>Locatie:</strong> Muiden
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="package-cta">
      <a href="#arrangementen-overzicht" class="package-back-link">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: inline-block; vertical-align: middle; margin-right: 4px;">
          <path d="M8 12V4M8 4L4 8M8 4L12 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Alle arrangementen
      </a>
      <a href="/offerte/?package={{ pkg.slug }}" class="btn btn-md">Bereken je prijs</a>
    </div>
  </div>
</section>
{% endfor %}


