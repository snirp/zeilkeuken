---
layout: layouts/base.njk
---

<!-- Hero Section -->
<section id="hero" class="hero-section">
  <video class="hero-video" autoplay loop muted playsinline>
    <source src="/images/hero.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 class="hero-title" data-content-id="hero-title">Wind. Smaak. Contact.</h1>
    <p class="hero-subtitle" data-content-id="hero-subtitle">
      Vaar vanaf Muiden over het IJsselmeer op onze historische Tjalk,
      met familie, vrienden of collega's tot 40 personen.
      Goed eten, open water, échte gesprekken.
    </p>
    <div class="hero-ctas">
      <a href="/offerte/" class="btn btn-lg btn-outline-primary" data-content-id="hero-cta-primary">Boek nu</a>
      <a href="/arrangementen/" class="btn btn-lg btn-outline" data-content-id="hero-cta-secondary">Arrangementen</a>
    </div>
  </div>
  <div class="scroll-hint" aria-label="Scroll voor meer">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 5L12 19M12 19L19 12M12 19L5 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</section>

<!-- Value Proposition -->
<section id="proposition" class="section section-white value-proposition">
  <div class="section-container">
    <h2 data-content-id="proposition-title">Oud karakter, nieuwe wind</h2>
    <p data-content-id="proposition-content">
      Een kwartier vanaf Amsterdam vaar je weg van de dagelijkse drukte. 
      De wind pakt de zeilen en de motor gaat uit.
      Wat blijft: de ruimte voor verbinding, het moment, en de smaak van verse producten.
    </p>
    <p data-content-id="proposition-content-2">
      Wat ons anders maakt: een 19e-eeuws zeilschip dat écht werkt voor events.
      Faciliteiten voor presentaties en workshops—maar dan met het IJsselmeer als achtergrond. 
      En tussendoor? Even voor Fort Pampus liggen, of wandelen door vissersdorpen als Marken en Volendam.
      Transparante prijzen, eenvoudig boeken, geen verrassingen.
    </p>
  </div>
</section>

<!-- Ship Section -->
<section id="ship" class="section section-dark ship-section">
  <div class="section-container">
    <h2 data-content-id="ship-title">De Saffier – gebouwd in 1892</h2>
    <div class="ship-intro">
      <p data-content-id="ship-intro">
        Onze Groninger Tjalk is in 1892 gebouwd en voer op de Zuiderzee. Nu combineert het schip klassieke charme met moderne faciliteiten voor groepen tot 40 personen. Ruim dek, beschutte binnenkajuit, professionele kombuis met barbecue, en alle comfort die je nodig hebt voor een succesvolle dag op het IJsselmeer.
      </p>

    </div>
  </div>
  <div class="ship-gallery">
    <div class="ship-gallery-item ship-gallery-hero" data-content-id="ship-gallery-1">
      {% galleryImage "/images/schip-lijnen.jpg", "Touwwerk en lijnen van De Saffier", "(min-width: 768px) 40vw, 100vw", "480,960,1440" %}
    </div>
    <div class="ship-gallery-item" data-content-id="ship-gallery-2">
      {% galleryImage "/images/schip-anker.jpg", "Anker van De Saffier", "(min-width: 768px) 30vw, 50vw", "360,720" %}
    </div>
    <div class="ship-gallery-item" data-content-id="ship-gallery-3">
      {% galleryImage "/images/schip-kompas.jpg", "Kompas aan boord", "(min-width: 768px) 30vw, 50vw", "360,720" %}
    </div>
    <div class="ship-gallery-item ship-gallery-desktop" data-content-id="ship-gallery-4">
      {% galleryImage "/images/schip-roer.jpg", "Het roer van De Saffier", "(min-width: 768px) 30vw, 50vw", "360,720" %}
    </div>
    <div class="ship-gallery-item ship-gallery-desktop" data-content-id="ship-gallery-5">
      {% galleryImage "/images/schip-boeg.jpg", "De boeg van De Saffier", "(min-width: 768px) 30vw, 50vw", "360,720" %}
    </div>
  </div>
</section>

<!-- Ship Gallery Lightbox -->
<div class="ship-lightbox" id="ship-lightbox">
  <button class="ship-lightbox-close" aria-label="Galerij sluiten">&times;</button>
  <button class="ship-lightbox-nav ship-lightbox-prev" aria-label="Vorige foto">&lt;</button>
  <button class="ship-lightbox-nav ship-lightbox-next" aria-label="Volgende foto">&gt;</button>
  <img class="ship-lightbox-image" src="" alt="" />
  <div class="ship-lightbox-counter">
    <span id="ship-current">1</span> / <span id="ship-total">5</span>
  </div>
</div>

<!-- Destinations -->
<section id="destinations" class="section section-white destinations">
  <div class="section-container">
    <h2 data-content-id="destinations-title">Zeilen op het Markermeer</h2>
    <div class="text-content">
      <p data-content-id="destinations-intro">
        We varen over het Markermeer naar historische plekken als Pampus, Marken en Volendam. Wie wil helpen met de zeilen is welkom—onze bemanning legt graag uit hoe het werkt. Liever rustig meedeinen? Ook goed. Het tempo ligt laag, de zeilen doen het werk, en tussen het varen door leggen we aan voor een wandeling of lunch. Wind en water bepalen de exacte route, maar de bestemming staat vast: een dag waarop je even weg bent van alles.
      </p>
    </div>

    <div class="map-container">
      <div class="destination-cards">
        <div class="card scroll-reveal" data-content-id="destinations-card-1">
          <h3>Fort Pampus</h3>
          <div class="badge-group">
            <span class="badge">45 min</span>
            <span class="badge">Forteiland</span>
          </div>
          <p class="destination-description">Eens het slot op de stelling van Amsterdam en nu een museum. Verken de historie van het eiland, of neem een verfrissende duik.</p>
        </div>

        <div class="card scroll-reveal" data-content-id="destinations-card-2">
          <h3>Volendam</h3>
          <div class="badge-group">
            <span class="badge">1.5 uur</span>
            <span class="badge">Pittoresk</span>
          </div>
          <p class="destination-description">
            De geboortegrond van de palingsound. Dit vissersdorp is beroemd om "de" dijk.
          </p>
        </div>

        <div class="card scroll-reveal" data-content-id="destinations-card-3">
          <h3>Marken</h3>
          <div class="badge-group">
            <span class="badge">1 uur</span>
            <span class="badge">Vissersdorp</span>
          </div>
          <p class="destination-description">
            Verlies jezelf in de historie van dit voormalige eiland, met haar authentieke houten huisjes.
          </p>
        </div>

        <div class="card scroll-reveal" data-content-id="destinations-card-4">
          <h3>Muiden</h3>
          <div class="badge-group">
            <span class="badge">Thuishaven</span>
            <span class="badge">Vesting</span>
          </div>
          <p class="destination-description">
            Verken de vestingstad Muiden, met haar middeleeuwse kasteel en gezellige haven. De perfecte eindbestemming.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Food Experience -->
<section id="food" class="section section-white food-experience">
  <div class="section-container">
    <h2 data-content-id="food-title">Verse producten aan boord</h2>
    <div class="food-intro">
      <p data-content-id="food-content">
        Als 17-jarig maatje op een charterschip leerde schipper Nick één ding: een geslaagde zeiltocht 
        draait om gastvrijheid. Jaren later, na de zeevaartschool en restaurantkeukens, kocht hij De Saffier. 
        Niet om zeiltochten te verkopen, maar om te doen wat nergens anders kan: vis halen bij de vissers 
        in Volendam, groenten ophalen bij boeren die hij kent, en het aan boord klaarma­ken. Je ruikt 
        de rook voor de wind komt, proeft wanneer iets écht vers is. Dat is de basis—en we stemmen 
        het menu en de setting af op jouw groep.
      </p>
      <a href="/keuken/" class="btn btn-md btn-secondary" data-content-id="food-read-more">Menu's, leveranciers en werkwijze →</a>
    </div>
  </div>
  <div class="food-images">
    {% galleryImage "/images/keuken-tafel.jpg", "Gedekte tafel aan boord", "(min-width: 768px) 50vw, 100vw", "480,960,1440" %}
    <div class="food-image-desktop">
      {% galleryImage "/images/keuken-salade.jpg", "Salade bereid aan boord", "(min-width: 768px) 50vw, 100vw", "480,960,1440" %}
    </div>
  </div>
</section>

<!-- Packages -->
<section id="packages" class="section section-white packages">
  <div class="section-container">
    <h2 data-content-id="packages-title">Arrangementen</h2>
    <div class="text-content">
      <p data-content-id="packages-intro">
        We varen van april tot oktober met groepen tot 40 personen vanuit Muiden. Onderstaande arrangementen zijn startpunten—elk arrangement kun je aanpassen aan jouw wensen.
      </p>
    </div>

    <div class="package-cards grid-2">
      {% set pkg = packages.dagtocht %}
      <a href="/arrangementen/#dagtocht" class="card card-package card-hover package-card-link scroll-reveal">
        <div class="package-header">
          <h3>{{ pkg.content.name }}</h3>
        </div>
        <div class="badge-group">
          {% for badge in pkg.content.badges %}
          <span class="badge">{{ badge }}</span>
          {% endfor %}
        </div>
        <p class="package-description">{{ pkg.content.shortDescription }}</p>
        <span class="link package-cta">Details →</span>
      </a>

      {% set pkg = packages.langevaart %}
      <a href="/arrangementen/#langevaart" class="card card-package card-hover package-card-link scroll-reveal">
        <div class="package-header">
          <h3>{{ pkg.content.name }}</h3>
        </div>
        <div class="badge-group">
          {% for badge in pkg.content.badges %}
          <span class="badge">{{ badge }}</span>
          {% endfor %}
        </div>
        <p class="package-description">{{ pkg.content.shortDescription }}</p>
        <span class="link package-cta">Details →</span>
      </a>

      {% set pkg = packages.dinervaart %}
      <a href="/arrangementen/#dinervaart" class="card card-package card-hover package-card-link scroll-reveal">
        <div class="package-header">
          <h3>{{ pkg.content.name }}</h3>
        </div>
        <div class="badge-group">
          {% for badge in pkg.content.badges %}
          <span class="badge">{{ badge }}</span>
          {% endfor %}
        </div>
        <p class="package-description">{{ pkg.content.shortDescription }}</p>
        <span class="link package-cta">Details →</span>
      </a>

      {% set pkg = packages.flexibel %}
      <a href="/arrangementen/#flexibel" class="card card-package card-hover package-card-link scroll-reveal">
        <div class="package-header">
          <h3>{{ pkg.content.name }}</h3>
        </div>
        <div class="badge-group">
          {% for badge in pkg.content.badges %}
          <span class="badge">{{ badge }}</span>
          {% endfor %}
        </div>
        <p class="package-description">{{ pkg.content.shortDescription }}</p>
        <span class="link package-cta">Details →</span>
      </a>
    </div>
  </div>
</section>

<!-- Why Us (merged sustainability + differentiation) -->
<section id="why-us" class="section section-dark why-us-section">
  <div class="section-container">
    <h2 data-content-id="why-us-title">Waarom De Zeilkeuken</h2>
    <div class="why-us-content">
    </div>
    
    <div class="why-us-grid">
      <div class="why-us-item" data-content-id="why-us-sustainability">
        <h3>Duurzaam Varen</h3>
        <p>
          Zeilen draait om de kracht van de wind. We varen zoveel mogelijk op windkracht, 
          gebruiken verse lokale ingrediënten, en serveren op echt servies. 
          Niet omdat het moet, maar omdat het logisch is.
        </p>
        <ul class="list-check">
          <li>Windkracht als motor</li>
          <li>Lokale leveranciers binnen 20 km</li>
          <li>Biologische producten waar mogelijk</li>
          <li>Geen wegwerpplastic</li>
        </ul>
      </div>
      
      <div class="why-us-item" data-content-id="why-us-flexibility">
        <h3>Persoonlijke aandacht</h3>
        <p>
          Vooraf praat je met iemand die het schip kent en meedenkt over jouw dag: 
          menu, dagindeling, wat er anders moet. Aan boord staat een bemanning die 
          weet dat een goede dag niet vanzelf gaat — attent, zonder opdringerig te 
          zijn. Eerlijke prijzen, en duidelijkheid over wat wél en niet kan.
        </p>
        <ul class="list-check">
          <li>Maatwerk arrangementen</li>
          <li>Presentatie faciliteiten aan boord</li>
          <li>Transparante prijzen</li>
          <li>Ervaren bemanning</li>
        </ul>
      </div>
    </div>
    
    <div class="section-cta">
      <a href="/offerte/" class="btn btn-lg" data-content-id="why-us-cta">Plan je zeiltocht →</a>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section id="testimonials" class="section section-white testimonials">
  <div class="section-container">
    <div class="testimonial-cards grid-2">
      <div class="card card-testimonial" data-content-id="testimonials-card-1">
        <div class="testimonial-avatar"></div>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut
          labore et dolore magna aliqua.
        </p>
      </div>

      <div class="card card-testimonial" data-content-id="testimonials-card-2">
        <div class="testimonial-avatar"></div>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut
          labore et dolore magna aliqua.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section id="faq" class="section section-white">
  <div class="section-container">
    <h2 data-content-id="home-faq-title">Veelgestelde Vragen</h2>
    {% set page = "home" %}
    {% include "components/faq-list.njk" %}
  </div>
</section>

<script>
  (function () {
    const galleryImages = document.querySelectorAll('.ship-gallery img');
    const lightbox = document.getElementById('ship-lightbox');
    const lightboxImage = lightbox.querySelector('.ship-lightbox-image');
    const closeBtn = lightbox.querySelector('.ship-lightbox-close');
    const prevBtn = lightbox.querySelector('.ship-lightbox-prev');
    const nextBtn = lightbox.querySelector('.ship-lightbox-next');
    const currentEl = document.getElementById('ship-current');
    const totalEl = document.getElementById('ship-total');

    let currentIndex = 0;
    const totalImages = galleryImages.length;

    totalEl.textContent = totalImages;

    function openLightbox(index) {
      currentIndex = index;
      updateLightboxImage();
      lightbox.classList.add('ship-lightbox-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('ship-lightbox-open');
      document.body.style.overflow = '';
    }

    function updateLightboxImage() {
      const img = galleryImages[currentIndex];
      lightboxImage.src = getFullSrc(img);
      lightboxImage.alt = img.alt;
      currentEl.textContent = currentIndex + 1;
    }

    function getFullSrc(img) {
      const picture = img.closest('picture');
      if (!picture) return img.src;
      const source = picture.querySelector('source[type="image/webp"]') || picture.querySelector('source');
      if (!source) return img.src;
      const entries = source.srcset.split(',').map(s => s.trim());
      return entries[entries.length - 1].split(' ')[0];
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % totalImages;
      updateLightboxImage();
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + totalImages) % totalImages;
      updateLightboxImage();
    }

    // Event listeners
    galleryImages.forEach((img, index) => {
      img.style.cursor = 'pointer';
      img.addEventListener('click', () => openLightbox(index));
    });

    closeBtn.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', showPrev);
    nextBtn.addEventListener('click', showNext);

    // Close on overlay click
    lightbox.addEventListener('click', e => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', e => {
      if (!lightbox.classList.contains('ship-lightbox-open')) return;

      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  })();
</script>
