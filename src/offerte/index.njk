---
layout: layouts/base.njk
title: De Zeilkeuken - Vraag een offerte aan
---

<script>
  // Inject pricing data from 11ty build - MUST load before stepped-form.js
  window.PRICING_DATA = {
    boatRental: {{ pricing.boatRental | dump | safe }},
    children: {{ pricing.children | dump | safe }},
    drinks: {{ pricing.drinks | dump | safe }},
    lunch: {{ pricing.lunch | dump | safe }},
    borrel: {{ pricing.borrel | dump | safe }},
    dinner: {{ pricing.dinner | dump | safe }},
    packages: {
      {% for pkg in packages %}
      {{ pkg.id }}: {
        name: {{ pkg.content.name | dump | safe }},
        minGuests: {{ pkg.constraints.minGuests }},
        maxGuests: {{ pkg.constraints.maxGuests }},
        defaultDeparture: {% if pkg.defaults.departure %}{{ pkg.defaults.departure | dump | safe }}{% else %}null{% endif %},
        defaultEndTime: {% if pkg.defaults.endTime %}{{ pkg.defaults.endTime | dump | safe }}{% else %}null{% endif %},
        defaultDuration: {% if pkg.defaults.departure and pkg.defaults.endTime %}{{ pkg.defaults.departure | durationHours(pkg.defaults.endTime) }}{% else %}null{% endif %},
        dateRange: {% if pkg.constraints.seasonStart %}{ start: {{ pkg.constraints.seasonStart | dump | safe }}, end: {{ pkg.constraints.seasonEnd | dump | safe }} }{% else %}null{% endif %}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    }
  };
</script>

<!-- Hero Section -->
<section class="section quote-hero">
  <h1 data-content-id="quote-hero-title">Binnen 24 uur een vrijblijvende offerte op maat</h1>
</section>

<!-- Quote Form -->
<section class="section quote-form-section">
  <form class="stepped-form" action="/api/quote-request" method="POST">
    <!-- Progress Indicator -->
    <div class="form-progress">
      <div class="progress-bar">
        <div class="progress-fill"></div>
        <span class="progress-boat">⛵</span>
      </div>
      <div class="progress-steps">
        <span class="progress-step active" data-step="1">1. Vaart</span>
        <span class="progress-step" data-step="2">2. Catering</span>
        <span class="progress-step" data-step="3">3. Gegevens</span>
      </div>
    </div>

    <!-- Step 1: Vaart -->
    <div class="form-step vaart-step" data-step="1" aria-hidden="false">
      <div class="form-section" data-content-id="quote-section-vaart">
        <div class="form-row">
          <div class="form-group">
            <label for="date" data-content-id="quote-label-date">Gewenste datum *</label>
            <input type="date" id="date" name="date" required />
          </div>
        </div>

        <p data-content-id="quote-packages-subtitle">
          Selecteer het arrangement dat het beste bij je past. Je kunt later nog aanpassingen
          aangeven.
        </p>

        <div class="package-selection">
          {% for pkg in packages %} {% if pkg.id == "dagtocht" %}
          <label class="package-option">
            <input type="radio" name="package" value="dagtocht" required />
            <span>{{ pkg.content.name }} <strong>{% if pkg.price %}€{{ pkg.price }} pp{% endif %}</strong></span>
            <p class="package-description">
              {{ pkg.content.shortDescription }}
              <button type="button" class="inline-details-link" data-modal="dagtocht-modal">
                ⓘ Bekijk details
              </button>
            </p>
          </label>
          {% endif %} {% endfor %}

          {% for pkg in packages %} {% if pkg.id == "langevaart" %}
          <label class="package-option">
            <input type="radio" name="package" value="langevaart" required />
            <span>{{ pkg.content.name }} <strong>{% if pkg.price %}€{{ pkg.price }} pp{% endif %}</strong></span>
            <p class="package-description">
              {{ pkg.content.shortDescription }}
              <button type="button" class="inline-details-link" data-modal="langevaart-modal">
                ⓘ Bekijk details
              </button>
            </p>
          </label>
          {% endif %} {% endfor %}

          {% for pkg in packages %} {% if pkg.id == "dinervaart" %}
          <label class="package-option">
            <input type="radio" name="package" value="dinervaart" required />
            <span>{{ pkg.content.name }} <strong>{% if pkg.price %}€{{ pkg.price }} pp{% endif %}</strong></span>
            <p class="package-description">
              {{ pkg.content.shortDescription }}
              <button type="button" class="inline-details-link" data-modal="dinervaart-modal">
                ⓘ Bekijk details
              </button>
            </p>
          </label>
          {% endif %} {% endfor %}

          {% for pkg in packages %} {% if pkg.id == "flexibel" %}
          <label class="package-option">
            <input type="radio" name="package" value="flexibel" required />
            <span>{{ pkg.content.name }} <strong>{% if pkg.price %}€{{ pkg.price }} pp{% else %}Op maat{% endif %}</strong></span>
            <p class="package-description">
              {{ pkg.content.shortDescription }}
              <button type="button" class="inline-details-link" data-modal="flexibel-modal">
                ⓘ Bekijk details
              </button>
            </p>
          </label>
          {% endif %} {% endfor %}
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="departure" data-content-id="quote-label-departure"
              >Vertrektijd *</label
            >
            <select id="departure" name="departure" required>
              <option value="" data-content-id="quote-departure-placeholder">Selecteer tijd</option>
              <option value="08:00">08:00</option>
              <option value="08:30">08:30</option>
              <option value="09:00">09:00</option>
              <option value="09:30">09:30</option>
              <option value="10:00">10:00</option>
              <option value="10:30">10:30</option>
              <option value="11:00">11:00</option>
              <option value="11:30">11:30</option>
              <option value="12:00">12:00</option>
              <option value="12:30">12:30</option>
              <option value="13:00">13:00</option>
              <option value="13:30">13:30</option>
              <option value="14:00">14:00</option>
              <option value="14:30">14:30</option>
              <option value="15:00">15:00</option>
              <option value="15:30">15:30</option>
              <option value="16:00">16:00</option>
              <option value="16:30">16:30</option>
              <option value="17:00">17:00</option>
              <option value="17:30">17:30</option>
              <option value="18:00">18:00</option>
              <option value="18:30">18:30</option>
              <option value="19:00">19:00</option>
              <option value="19:30">19:30</option>
              <option value="20:00">20:00</option>
            </select>
          </div>

          <div class="form-group">
            <label for="arrival" data-content-id="quote-label-arrival">Aankomsttijd *</label>
            <select id="arrival" name="arrival" required>
              <option value="" data-content-id="quote-arrival-placeholder">Selecteer tijd</option>
              <option value="10:00">10:00</option>
              <option value="10:30">10:30</option>
              <option value="11:00">11:00</option>
              <option value="11:30">11:30</option>
              <option value="12:00">12:00</option>
              <option value="12:30">12:30</option>
              <option value="13:00">13:00</option>
              <option value="13:30">13:30</option>
              <option value="14:00">14:00</option>
              <option value="14:30">14:30</option>
              <option value="15:00">15:00</option>
              <option value="15:30">15:30</option>
              <option value="16:00">16:00</option>
              <option value="16:30">16:30</option>
              <option value="17:00">17:00</option>
              <option value="17:30">17:30</option>
              <option value="18:00">18:00</option>
              <option value="18:30">18:30</option>
              <option value="19:00">19:00</option>
              <option value="19:30">19:30</option>
              <option value="20:00">20:00</option>
              <option value="20:30">20:30</option>
              <option value="21:00">21:00</option>
              <option value="21:30">21:30</option>
              <option value="22:00">22:00</option>
              <option value="22:30">22:30</option>
              <option value="23:00">23:00</option>
              <option value="23:30">23:30</option>
            </select>
            <p class="form-help" data-content-id="quote-help-arrival">Min. 2 uur, max. 12 uur vaartijd</p>
          </div>
        </div>

        <!-- Boat Rental Price Estimate -->
        <div class="price-estimate">
          <strong>Scheepshuur:</strong>
          <span id="price-estimate">—</span>
        </div>
      </div>
    </div>

    <!-- Step 2: Catering -->
    <div class="form-step catering-step" data-step="2" aria-hidden="true">
      <div class="form-section" data-content-id="quote-section-catering">
        <div class="form-row">
          <div class="form-group">
            <label for="adults" data-content-id="quote-label-adults">Aantal volwassenen *</label>
            <input
              type="number"
              id="adults"
              name="adults"
              min="1"
              max="40"
              required
              placeholder="1-40"
            />
          </div>
          <div class="form-group">
            <label for="children" data-content-id="quote-label-children">Aantal kinderen (t/m 12)</label>
            <input
              type="number"
              id="children"
              name="children"
              min="0"
              max="39"
              value="0"
              placeholder="0"
            />
            <p class="form-help">Totaal max. 40 personen</p>
          </div>
        </div>

        <p data-content-id="quote-catering-intro">
          Stel je catering samen op basis van je vaartijd. Opties worden automatisch aan- of
          uitgezet op basis van het tijdstip van je tocht.
        </p>

        <!-- Drinks -->
        <fieldset class="catering-group" id="catering-drinks">
          <legend>Dranken</legend>
          <div class="catering-options">
            <label class="catering-option">
              <input type="radio" name="drinks" value="advanceBilling" checked />
              <span>Voorschot <strong id="drinks-advance-price">(€3,50 pppu)</strong></span>
              <p class="catering-description">Laag voorschot, nacalculatie op werkelijk verbruik</p>
            </label>
            <label class="catering-option">
              <input type="radio" name="drinks" value="dutchBar" />
              <span>Nederlandse bar <strong id="drinks-dutch-price">(€10 pppu)</strong></span>
              <p class="catering-description">Bier, wijn, fris en warme dranken onbeperkt</p>
            </label>
            <label class="catering-option">
              <input type="radio" name="drinks" value="winePackage" />
              <span>Wijnpakket <strong id="drinks-wine-price">(€15 pppu)</strong></span>
              <p class="catering-description">Premium wijnselectie met bijpassende dranken</p>
            </label>
          </div>
        </fieldset>

        <!-- Lunch -->
        <fieldset class="catering-group" id="catering-lunch">
          <legend>Lunch</legend>
          <div class="catering-options">
            <label class="catering-option">
              <input type="radio" name="lunch" value="none" checked />
              <span>Geen lunch</span>
            </label>
            <label class="catering-option">
              <input type="radio" name="lunch" value="standard" />
              <span>Lunch <strong id="lunch-price">(€25 pp)</strong></span>
              <p class="catering-description">Uitgebreide lunch met verse lokale ingrediënten</p>
            </label>
          </div>
        </fieldset>

        <!-- Borrel -->
        <fieldset class="catering-group" id="catering-borrel">
          <legend>Borrel</legend>
          <div class="catering-options">
            <label class="catering-option">
              <input type="radio" name="borrel" value="none" checked />
              <span>Geen borrel</span>
            </label>
            <label class="catering-option">
              <input type="radio" name="borrel" value="dutch" />
              <span>Hollandse borrel <strong id="borrel-dutch-price">(€18 pp)</strong></span>
              <p class="catering-description">Klassieke borrelhapjes en kaasplank</p>
            </label>
            <label class="catering-option">
              <input type="radio" name="borrel" value="luxury" />
              <span>Luxe borrel <strong id="borrel-luxury-price">(€25 pp)</strong></span>
              <p class="catering-description">Premium borrelpakket met verse oesters en delicatessen</p>
            </label>
          </div>
        </fieldset>

        <!-- Dinner -->
        <fieldset class="catering-group" id="catering-dinner">
          <legend>Diner</legend>
          <div class="catering-options">
            <label class="catering-option">
              <input type="radio" name="dinner" value="none" checked />
              <span>Geen diner</span>
            </label>
            <label class="catering-option">
              <input type="radio" name="dinner" value="walking" />
              <span>Walking dinner <strong id="dinner-walking-price">(€18 pp)</strong></span>
              <p class="catering-description">Staand diner met diverse kleine gerechten</p>
            </label>
            <label class="catering-option">
              <input type="radio" name="dinner" value="shared" />
              <span>Shared dinner <strong id="dinner-shared-price">(€25 pp)</strong></span>
              <p class="catering-description">Gezamenlijk dineren met gedeelde schotels</p>
            </label>
          </div>
        </fieldset>

        <!-- Catering Price Summary -->
        <div class="price-estimate">
          <strong>Catering totaal:</strong>
          <span id="catering-total">—</span>
        </div>
      </div>
    </div>

    <!-- Step 3: Personal Details & Preferences -->
    <div class="form-step details-step" data-step="3" aria-hidden="true">
      <div class="form-section" data-content-id="quote-section-contact">
        <div class="form-group">
          <label for="organization" data-content-id="quote-label-organization"
            >Bedrijf/organisatie (optioneel)</label
          >
          <input type="text" id="organization" name="organization" placeholder="Bedrijfsnaam" />
        </div>

        <div class="form-group">
          <label for="name" data-content-id="quote-label-name">Naam *</label>
          <input type="text" id="name" name="name" required placeholder="Voor- en achternaam" />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="email" data-content-id="quote-label-email">E-mailadres *</label>
            <input type="email" id="email" name="email" required placeholder="naam@voorbeeld.nl" />
          </div>

          <div class="form-group">
            <label for="phone" data-content-id="quote-label-phone"
              >Telefoonnummer <span style="color: var(--color-gray-600)">(optioneel)</span></label
            >
            <input type="tel" id="phone" name="phone" placeholder="06 12345678" />
          </div>
        </div>

        <div class="form-group">
          <label for="requests" data-content-id="quote-label-requests"
            >Heb je specifieke wensen of vragen?</label
          >
          <textarea
            id="requests"
            name="requests"
            rows="5"
            placeholder="Bijv: specifieke route-wensen, muziek aan boord, activiteiten, dieetwensen, tijdstip aanpassen..."
          ></textarea>
        </div>
      </div>

      <!-- Price Calculator -->
      <div class="form-section price-calculator" data-content-id="quote-section-calculator">
        <h2 data-content-id="quote-calculator-title">Indicatieve prijs</h2>
        <div class="price-breakdown">
          <div class="price-line">
            <span data-content-id="quote-price-boat-label">Scheepshuur</span>
            <span class="price-value" id="boat-price">—</span>
          </div>
          <div class="price-line" id="catering-line" style="display: none">
            <span data-content-id="quote-price-catering-label">Catering</span>
            <span class="price-value" id="catering-price">€0</span>
          </div>
          <div class="price-line price-total">
            <span data-content-id="quote-price-total-label">Totaal (indicatief)</span>
            <span class="price-value" id="total-price">—</span>
          </div>
          <div class="price-line price-ex-vat">
            <span data-content-id="quote-price-exvat-label">Excl. 21% BTW</span>
            <span class="price-value" id="exvat-price">—</span>
          </div>
        </div>
        <p class="price-note" data-content-id="quote-price-note">
          Dit is een indicatie. Je ontvangt de definitieve offerte binnen 24 uur.
        </p>
      </div>
    </div>

    <!-- Navigation -->
    <div class="form-navigation">
      <button type="button" class="btn btn-back">Vorige</button>
      <button type="button" class="btn btn-next">Volgende</button>
      <button
        type="submit"
        class="btn btn-lg btn-submit"
        style="display: none"
        data-content-id="quote-submit-button"
      >
        Vrijblijvende offerte ontvangen
      </button>
    </div>
  </form>

  <!-- What Happens Next Timeline - Only visible on Step 3 -->
  <div class="next-steps-container" style="display: none" data-show-on-step="3">
    <h2 data-content-id="quote-next-title">Wat gebeurt er nu?</h2>

    <div class="timeline">
      <div class="timeline-item">
        <span class="timeline-number">1</span>
        <div class="timeline-content">
          <h3 data-content-id="quote-next-step1-title">Je aanvraag komt binnen</h3>
          <p data-content-id="quote-next-step1-text">
            We bekijken je wensen en controleren de beschikbaarheid voor je gewenste datum.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <span class="timeline-number">2</span>
        <div class="timeline-content">
          <h3 data-content-id="quote-next-step2-title">Offerte binnen 24 uur</h3>
          <p data-content-id="quote-next-step2-text">
            Je ontvangt een gedetailleerde offerte met prijs, programma en alle details per e-mail.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <span class="timeline-number">3</span>
        <div class="timeline-content">
          <h3 data-content-id="quote-next-step3-title">Samen verfijnen</h3>
          <p data-content-id="quote-next-step3-text">
            We bellen of mailen om eventuele vragen te bespreken en het programma verder af te
            stemmen.
          </p>
        </div>
      </div>

      <div class="timeline-item">
        <span class="timeline-number">4</span>
        <div class="timeline-content">
          <h3 data-content-id="quote-next-step4-title">Bevestiging & planning</h3>
          <p data-content-id="quote-next-step4-text">
            Bij akkoord bevestigen we de boeking en sturen we alle praktische informatie.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="section faq-section" data-content-id="quote-section-faq">
  <h2 data-content-id="quote-faq-title">Veelgestelde vragen</h2>
  {% set page = "quote" %}
  {% include "components/faq-list.njk" %}
</section>

<!-- Alternative Contact Footer -->
<section class="section contact-alternatives" data-content-id="quote-section-contact-alt">
  <h2 data-content-id="quote-alt-title">Liever direct contact?</h2>
  <p data-content-id="quote-alt-intro">
    Geen probleem! We staan ook graag telefonisch of per e-mail voor je klaar.
  </p>

  <div class="contact-options">
    <div class="contact-option">
      <span class="contact-icon">�</span>
      <div>
        <strong data-content-id="quote-alt-form-label">Contactformulier</strong>
        <a href="/contact/" data-content-id="quote-alt-form-link">Stel je vraag</a>
        <p data-content-id="quote-alt-form-response">Voor algemene vragen</p>
      </div>
    </div>

    <div class="contact-option">
      <span class="contact-icon">📞</span>
      <div>
        <strong data-content-id="quote-alt-phone-label">Bel ons</strong>
        <a href="tel:+31612345678" data-content-id="quote-alt-phone">+31 6 12 34 56 78</a>
        <p data-content-id="quote-alt-phone-hours">Ma-vr 9:00-18:00</p>
      </div>
    </div>

    <div class="contact-option">
      <span class="contact-icon">✉️</span>
      <div>
        <strong data-content-id="quote-alt-email-label">Mail ons</strong>
        <a href="mailto:info@dezeilkeuken.nl" data-content-id="quote-alt-email"
          >info@dezeilkeuken.nl</a
        >
        <p data-content-id="quote-alt-email-response">Binnen 24u reactie</p>
      </div>
    </div>
  </div>
</section>

<!-- Package Detail Modals -->
{% for pkg in packages %} {% if pkg.id == "dagtocht" %}
<div id="dagtocht-modal" class="modal">
  <div class="modal-content">
    <button class="modal-close" aria-label="Sluiten">&times;</button>
    <h2>{{ pkg.content.heroSubtitle }}</h2>
    <p class="modal-meta">
      {% if pkg.defaults.endTime %}{{ pkg.defaults.departure }} - {{ pkg.defaults.endTime }} • {% endif %}€{{ pkg.price
      }} pp
    </p>

    <div>{{ pkg.content.longDescription | markdown | safe }}</div>

    <h3>Wat is inbegrepen</h3>
    <ul class="list-check">
      {% for highlight in pkg.content.highlights %}
      <li>{{ highlight }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %} {% endfor %} {% for pkg in packages %} {% if pkg.id == "langevaart" %}
<div id="langevaart-modal" class="modal">
  <div class="modal-content">
    <button class="modal-close" aria-label="Sluiten">&times;</button>
    <h2>{{ pkg.content.heroSubtitle }}</h2>
    <p class="modal-meta">
      {% if pkg.defaults.endTime %}{{ pkg.defaults.departure }} - {{ pkg.defaults.endTime }} • {% endif %}€{{ pkg.price
      }} pp
    </p>

    <div>{{ pkg.content.longDescription | markdown | safe }}</div>

    <h3>Wat is inbegrepen</h3>
    <ul class="list-check">
      {% for highlight in pkg.content.highlights %}
      <li>{{ highlight }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %} {% endfor %} {% for pkg in packages %} {% if pkg.id == "dinervaart" %}
<div id="dinervaart-modal" class="modal">
  <div class="modal-content">
    <button class="modal-close" aria-label="Sluiten">&times;</button>
    <h2>{{ pkg.content.heroSubtitle }}</h2>
    <p class="modal-meta">
      {% if pkg.defaults.endTime %}{{ pkg.defaults.departure }} - {{ pkg.defaults.endTime }} • {% endif %}€{{ pkg.price
      }} pp
    </p>

    <div>{{ pkg.content.longDescription | markdown | safe }}</div>

    <h3>Wat is inbegrepen</h3>
    <ul class="list-check">
      {% for highlight in pkg.content.highlights %}
      <li>{{ highlight }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %} {% endfor %} {% for pkg in packages %} {% if pkg.id == "flexibel" %}
<div id="flexibel-modal" class="modal">
  <div class="modal-content">
    <button class="modal-close" aria-label="Sluiten">&times;</button>
    <h2>{{ pkg.content.heroSubtitle }}</h2>
    <p class="modal-meta">Op aanvraag • Prijs op maat</p>

    <h3>Volledig naar jouw wensen</h3>
    <div>{{ pkg.content.longDescription | markdown | safe }}</div>
    <ul class="list-check">
      {% for highlight in pkg.content.highlights %}
      <li>{{ highlight }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %} {% endfor %}

<script>
  // Modal handling for package details
  (function () {
    const modalTriggers = document.querySelectorAll('[data-modal]');
    const modals = document.querySelectorAll('.modal');
    const modalCloses = document.querySelectorAll('.modal-close');

    modalTriggers.forEach(trigger => {
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        const modalId = this.getAttribute('data-modal');
        const modal = document.getElementById(modalId);
        if (modal) {
          modal.classList.add('modal-open');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    function closeModal(modal) {
      modal.classList.remove('modal-open');
      document.body.style.overflow = '';
    }

    modalCloses.forEach(closeBtn => {
      closeBtn.addEventListener('click', function () {
        closeModal(this.closest('.modal'));
      });
    });

    modals.forEach(modal => {
      modal.addEventListener('click', function (e) {
        if (e.target === this) closeModal(this);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        modals.forEach(modal => {
          if (modal.classList.contains('modal-open')) closeModal(modal);
        });
      }
    });
  })();
</script>
